generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  firstName  String?
  lastName   String?
  username   String?
  displayName String?
  role        String?
  language    String   @default("ru")
  location    String?
  shiftStartedAt DateTime?
  createdAt  DateTime @default(now())

  runs   Run[]
  shifts Shift[]
  userRoles UserRole[]
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String
  language  String   @default("ru")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Checklist {
  id          Int        @id @default(autoincrement())
  key         String     @unique
  title       String
  description String?
  role        String
  type        String
  language    String     @default("ru")
  displayOrder Int       @default(100)
  timeWindows String?
  intervalHours Int?

  questions Question[]
  runs      Run[]
}

model Translation {
  id         Int      @id @default(autoincrement())
  sourceLang String
  targetLang String
  sourceHash String
  sourceText String
  targetText String
  createdAt  DateTime @default(now())

  @@unique([sourceLang, targetLang, sourceHash])
}

model Question {
  id                  Int      @id @default(autoincrement())
  checklistId         Int
  text                String
  order               Int
  isRequired          Boolean  @default(true)
  taskType            String   @default("photo")
  section             String?
  weight              Int      @default(50)
  canSkip             Boolean  @default(false)
  createViolationOnNo Boolean  @default(true)
  referencePhoto String?
  aiRule      String?

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  answers   Answer[]
  violations Violation[]
}

model Run {
  id            Int       @id @default(autoincrement())
  userId        Int
  checklistId   Int
  shiftId       Int?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  earnedWeight  Int?
  possibleWeight Int?
  scorePercent  Float?
  hasDeviation  Boolean   @default(false)
  violationCount Int      @default(0)
  rejectedPhotoCount Int  @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklist Checklist @relation(fields: [checklistId], references: [id])
  shift     Shift?    @relation(fields: [shiftId], references: [id])
  answers   Answer[]
  violations Violation[]
}

model Answer {
  id             Int      @id @default(autoincrement())
  runId          Int
  questionId     Int
  value          String
  checkResult    String?
  earnedWeight   Int?
  possibleWeight Int?
  aiVerdict      String?
  aiReason       String?
  aiConfidence   Float?
  skipComment    String?
  photoHash      String?
  createdAt      DateTime @default(now())

  deferCount       Int       @default(0)
  firstDeferredAt  DateTime?
  lastDeferredAt   DateTime?

  run      Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  violation Violation?
}

model Shift {
  id        Int      @id @default(autoincrement())
  userId    Int
  startedAt DateTime @default(now())
  endedAt   DateTime?
  minutes   Int?
  failCount Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs Run[]
}

model InviteCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  createdBy String    // telegram_id админа
  usedBy    String?   // telegram_id сотрудника
  usedAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime
}

model Outbox {
  id             Int      @id @default(autoincrement())
  eventType      String   // 'answer' | 'shift_summary'
  payloadJson    String   // JSON строка с данными для Make
  idempotencyKey String   @unique // 'answer:{runId}:{questionId}' или 'shift:{shiftId}'
  status         String   @default("pending") // pending | sent | failed
  attempts       Int      @default(0)
  nextRetryAt    DateTime @default(now())
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Violation {
  id         Int       @id @default(autoincrement())
  runId      Int
  questionId Int
  answerId   Int       @unique
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  run      Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
}
