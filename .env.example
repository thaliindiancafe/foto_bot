# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# База данных
DATABASE_URL="file:./dev.db"

# Режим тестирования (показывает все чек-листы без фильтра по времени)
TEST_MODE=false

# Опционально: белый список telegram_id через запятую. Если задан — все остальные
# пользователи получают «У вас нет доступа к этому боту». Пусто = доступ открыт всем.
ALLOWED_USER_IDS=

# Локальная папка для фото, если ENABLE_GOOGLE_DRIVE=false (по умолчанию ./uploads).
# LOCAL_STORAGE_PATH=./uploads

# OpenAI API ключ для AI-проверки фото
OPENAI_API_KEY=

# Порог уверенности ИИ для отклонения фото (0.0–1.0). Выше = мягче (меньше отказов). По умолчанию 0.7.
# AI_FAIL_MIN_CONFIDENCE=0.7

# Бизнес-таймзона: операционный день считается с 06:00 по этому поясу,
# к нему же привязано расписание чек-листов и штампы на фото. По умолчанию Europe/Moscow.
# BUSINESS_TIMEZONE=Europe/Moscow

# Максимальный возраст EXIF-даты фото в минутах — снимки старше отклоняются
# как «не своевременные». По умолчанию 10.
# EXIF_MAX_AGE_MINUTES=10

# ID администраторов (через запятую) — доступ к админ-панели и slash-командам
ADMIN_IDS=
# Кому шлются stack-trace ошибки (🚨 Критическая ошибка бота).
# Опционально. Если не задан — fallback на первого из ADMIN_IDS.
# Менеджеры-админы НЕ должны быть здесь — только разработчик(и).
ERROR_NOTIFY_IDS=
OWNER_ID=

# ID общего рабочего чата (куда отправлять ошибки/нарушения), опционально
TEAM_CHAT_ID=

# ID менеджеров для уведомлений (через запятую)
MANAGER_IDS_RESTAURANT=
MANAGER_IDS_CAFE=

# --- Google: two different credential sets ---
#
# 1) Service account JSON (downloaded from Google Cloud Console).
#    Paste the FULL file content as one line into GOOGLE_SERVICE_ACCOUNT_JSON.
#    Used by: Google Sheets API (src/services/sheetsService.ts).
#    Share each target Spreadsheet with the service account email from that JSON
#    (the value of `client_email`, e.g. <name>@<project-id>.iam.gserviceaccount.com).
#    Share Drive folders with the same email for: staff photo uploads (GOOGLE_DRIVE_FOLDER_ID),
#    reference import (GOOGLE_DRIVE_REFERENCE_FOLDER_ID), and optional Drive cleanup.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: path to the same service account JSON file (relative to project root or absolute).
# Prefer this on Windows if GOOGLE_SERVICE_ACCOUNT_JSON fails to parse (multi-line / quotes in .env).
# GOOGLE_SERVICE_ACCOUNT_JSON_FILE=secrets/google-sa.json

# Optional: Google Drive folder with reference photos for checklists (default id is Thali shared folder).
# Share the folder with the service account email. Enable Drive API on the GCP project.
# Import: node --import tsx scripts/pullDriveReferencePhotos.ts
GOOGLE_DRIVE_REFERENCE_FOLDER_ID=

# Google Sheets — отчёты сотрудников, AI, фото (spreadsheet id from the URL).
# Листы должны существовать: Ресторан, Кофепоинт (ответы), Смены, Статистика.
GOOGLE_SHEETS_ID=

# 2) OAuth client (APIs & Services → Credentials → OAuth client ID).
#    Add redirect URIs (all three — script picks first free port):
#    http://127.0.0.1:54321/oauth2callback
#    http://127.0.0.1:38475/oauth2callback
#    http://127.0.0.1:41799/oauth2callback
#    Then run: npm run google:oauth
#    When ENABLE_GOOGLE_DRIVE=true, uploads use the service account above if JSON is set;
#    OAuth below is only a fallback if SA is missing.
# --- Google Drive: staff shift photos (upload + 30-day cleanup at 03:00) ---
# GOOGLE_DRIVE_FOLDER_ID = ID КОРНЕВОЙ папки (не подпапки сотрудника). Внутри бот создаёт папки по имени.
# Сервисный аккаунт может создать подпапку, но НЕ загрузить файл в обычный «Мой диск» (403).
# Решение 1 (проще): ENABLE_GOOGLE_DRIVE=true + OAuth ниже + npm run google:oauth → GOOGLE_REFRESH_TOKEN
# Решение 2: общий диск Google Workspace (Shared Drive), папка расшарена на SA с правом Редактор
ENABLE_GOOGLE_DRIVE=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
